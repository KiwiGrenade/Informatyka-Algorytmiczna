[82.533133, "o", "#!/bin/bash\r\n\r\ndeclare -Ai words\r\n\r\nfor file in $(find $1 -type f);\r\ndo\r\n\tfor word in $(cat $file | tr \" \" \"\\n\" | sort | uniq);\r\n\tdo\r\n\t\twords[$word]+=1\r\n\tdone\r\ndone\r\n\r\nfor word in ${!words[@]};\r\ndo\r\n\techo \"$word ${words[$word]}\"\r\ndone\r\n"]
