[53.852541, "o", "\r\n\u001b[?2004l\r"]
[53.856731, "o", "#!/bin/bash\r\n\r\ndeclare -Ai word_count\r\n\r\nsvn export -r $1 $2 tempfolder > /dev/null\r\n\r\nfile_array=($(find tempfolder -type f | tr ' ' '\\n'))\r\n\r\nfor i in \"${file_array[@]}\"\r\ndo\r\n   if [[ -f $i ]]; then\r\n   \tword_string=$(cat $i)\r\n   \twords=($(echo \"$word_string\" | tr ' ' '\\n'))\r\n   \tfor j in \"${words[@]}\"\r\n\tdo\r\n\t\tword_count[$j]=$((word_count[$j] + 1))\r\n\tdone\r\n   fi\r\ndone\r\nfor i in \"${!word_count[@]}\"\r\ndo\r\n  echo \"$i: ${word_count[$i]}\"\r\ndone\r\n\r\nrm -r tempfolder\r\n"]
[53.857978, "o", "\u001b[?2004h\u001b]0;jaskow@jaskow-HP-EliteBook-840-G5: ~/Repo/svn-kik/srodowisko-programisty/L3\u0007\u001b[01;32mjaskow@jaskow-HP-EliteBook-840-G5\u001b[00m:\u001b[01;34m~/Repo/svn-kik/srodowisko-programisty/L3\u001b[00m$ "]
[58.286922, "o", "\u001b[?2004l\r\r\nexit\r\n"]
